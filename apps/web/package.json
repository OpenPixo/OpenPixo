{
  "name": "@openpixo/web",
  "version": "0.25.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./sidecar": {
      "types": "./dist/sidecar/index.d.ts",
      "default": "./dist/sidecar/index.js"
    }
  },
  "files": [
    ".next",
    "!.next/cache",
    "app",
    "dist",
    "next.config.ts",
    "package.json",
    "public",
    "src"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && tsc -b --noEmit",
    "build:sidecar": "tsc -p tsconfig.sidecar.json",
    "typecheck": "next typegen && tsc -b --noEmit",
    "test": "vitest run -c vitest.config.ts --maxWorkers=2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@fontsource/instrument-serif": "5.2.8",
    "@fontsource/noto-serif-sc": "5.2.8",
    "@formkit/auto-animate": "0.9.0",
    "@lexical/react": "0.36.2",
    "@lexical/utils": "0.36.2",
    "@openpixo/components": "workspace:*",
    "@openpixo/contracts": "workspace:*",
    "@openpixo/host": "workspace:*",
    "@openpixo/platform": "workspace:*",
    "@openpixo/sidecar": "workspace:*",
    "@openpixo/sidecar-proto": "workspace:*",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "dompurify": "3.4.17",
    "geist": "1.5.1",
    "jspdf": "4.2.1",
    "lexical": "0.36.2",
    "lucide-react": "1.16.0",
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0",
    "motion": "12.40.0",
    "next": "16.4.5",
    "openai": "6.38.0",
    "posthog-js": "1.374.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "4.1.0",
    "thinking-orbs": "0.3.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "28.0.3",
    "@types/node": "20.19.39",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.185.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "jsdom": "29.1.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": "~24"
  }
}
